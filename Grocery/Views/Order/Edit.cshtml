@model Grocery.Models.Orders

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Order";
}

<div class="container-fluid py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #2e7d32;">Edit Order</h2>
            <small class="text-muted">Update order details, status, and payment information.</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 text-nowrap fw-semibold">
            ← Back to Orders
        </a>
    </div>

    <!-- FORM CARD -->
    <div class="row">
        <div class="col-12 col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4" style="background-color: #f8fbf7;">
                    <h5 class="fw-bold text-dark mb-0">Order Information (#@Model?.OrderID)</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <input type="hidden" asp-for="OrderID" />

                        <div class="row g-3">
                            <!-- ORDER NUMBER -->
                            <div class="col-12 col-md-6">
                                <label asp-for="OrderNumber" class="form-label fw-semibold text-dark fs-7">Order Number</label>
                                <input asp-for="OrderNumber" class="form-control bg-light py-2" placeholder="e.g. ORD-1001" />
                                <span asp-validation-for="OrderNumber" class="text-danger fs-7 d-block mt-1"></span>
                            </div>

                            <!-- TOTAL AMOUNT -->
                            <div class="col-12 col-md-6">
                                <label asp-for="TotalAmount" class="form-label fw-semibold text-dark fs-7">Total Amount ($)</label>
                                <input asp-for="TotalAmount" class="form-control bg-light py-2" placeholder="0.00" />
                                <span asp-validation-for="TotalAmount" class="text-danger fs-7 d-block mt-1"></span>
                            </div>

                            <!-- USER ID & USER -->
                            <div class="col-12 col-md-6">
                                <label asp-for="UserID" class="form-label fw-semibold text-dark fs-7">User ID</label>
                                <input asp-for="UserID" class="form-control bg-light py-2" />
                                <span asp-validation-for="UserID" class="text-danger fs-7 d-block mt-1"></span>
                            </div>

                            <!-- ORDER STATUS -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Orderstatus" class="form-label fw-semibold text-dark fs-7">Order Status</label>
                                <select asp-for="Orderstatus" class="form-select bg-light py-2">
                                    <option value="">-- Select Status --</option>
                                    <option value="Pending">Pending</option>
                                    <option value="In_Progress">In_Progress</option>
                                    <option value="Canceled">Canceled</option>
                                    <option value="Delivered">Delivered</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="Returned">Returned</option>
                                </select>
                                <span asp-validation-for="Orderstatus" class="text-danger fs-7 d-block mt-1"></span>
                            </div>

                           <!-- PAYMENT STATUS -->
                            <div class="col-12 col-md-6">
                                <label asp-for="PaymentStatus" class="form-label fw-semibold text-dark fs-7">Payment Status</label>
                                <select asp-for="PaymentStatus" class="form-select bg-light py-2">
                                    <option value="">-- Select Payment Status --</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Paid">Paid</option>
                                    <option value="Failed">Failed</option>
                                    <option value="Refunded">Refunded</option>
                                </select>
                                <span asp-validation-for="PaymentStatus" class="text-danger fs-7 d-block mt-1"></span>
                            </div>

                        </div>

                        <!-- FORM ACTIONS -->
                        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4 fw-semibold text-secondary">Cancel</a>
                            <button type="submit" class="btn text-white fw-bold px-4 py-2 rounded-3" style="background-color: #2e7d32;">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}