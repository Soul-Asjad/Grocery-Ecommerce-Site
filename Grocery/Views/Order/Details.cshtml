@model IEnumerable<Grocery.Models.OrderItems>

@{
    ViewData["Title"] = "Order Details";

    var firstItem = Model.FirstOrDefault();
    var orderId = firstItem?.OrderID ?? 0;
    var totalQuantity = Model.Sum(x => x.Quantity);
    var grandTotal = Model.Sum(x => x.TotalPrice);
}

<div class="container py-4">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #2e7d32;">Order Summary</h2>
            <p class="text-muted mb-0">Receipt details for Order <strong>#@orderId</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-success rounded-3 px-4 text-nowrap fw-semibold">
            ← Back to My Orders
        </a>
    </div>

    <!-- SUMMARY METRICS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="background-color: #f6fbf5;">
                <span class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Order Reference</span>
                <h4 class="fw-bold text-dark mb-0">#@orderId</h4>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="background-color: #f6fbf5;">
                <span class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Total Items</span>
                <h4 class="fw-bold text-dark mb-0">@totalQuantity</h4>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="background-color: #eaf5e9; border: 1px solid #d4ebd2;">
                <span class="text-uppercase fs-7 fw-bold d-block mb-1" style="color: #2e7d32;">Total Amount Paid</span>
                <h4 class="fw-bold mb-0" style="color: #2e7d32;">$@grandTotal.ToString("F2")</h4>
            </div>
        </div>
    </div>

    <!-- ORDER ITEMS TABLE CARD -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Items Purchased</h5>
            <span class="badge rounded-pill px-3 py-2 fw-bold fs-7" style="background-color: #eaf5e9; color: #2e7d32;">
                @Model.Count() Product(s)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-uppercase fs-7 fw-bold text-muted" style="background-color: #f8fbf7;">
                    <tr>
                        <th class="ps-4 py-3 text-nowrap">Item Description</th>
                        <th class="py-3 text-center text-nowrap">Quantity</th>
                        <th class="py-3 text-nowrap">Unit Price</th>
                        <th class="py-3 text-end pe-4 text-nowrap">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <h6 class="fw-semibold mb-1">No items found for this order.</h6>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- PRODUCT NAME -->
                                <td class="ps-4 py-3 text-nowrap">
                                    <span class="fw-bold text-dark fs-6">@item.ProductName</span>
                                </td>

                                <!-- QUANTITY -->
                                <td class="py-3 text-center text-nowrap">
                                    <span class="badge rounded-pill text-dark border px-3 py-1 fw-semibold" style="background-color: #f2f8f1;">
                                        x @item.Quantity
                                    </span>
                                </td>

                                <!-- PRICE -->
                                <td class="py-3 text-nowrap text-secondary fw-medium">
                                    $@item.Price.ToString("F2")
                                </td>

                                <!-- TOTAL PRICE -->
                                <td class="py-3 text-end pe-4 text-nowrap fw-bold" style="color: #2e7d32;">
                                    $@item.TotalPrice.ToString("F2")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot style="background-color: #f8fbf7;">
                    <tr>
                        <td colspan="3" class="text-end fw-bold py-3 text-uppercase fs-7 text-muted">Grand Total:</td>
                        <td class="text-end pe-4 py-3 fw-bold fs-5" style="color: #2e7d32;">$@grandTotal.ToString("F2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- FOOTER ACTIONS -->
        <div class="card-footer border-top p-3 text-end rounded-bottom-4" style="background-color: #fdfefd;">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold rounded-3">Back to Order List</a>
        </div>
    </div>
</div>