@model IEnumerable<Grocery.Models.Orders>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Orders List";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #2e7d32;">Orders Management</h2>
        <small class="text-muted">Manage store orders and fulfillment status.</small>
    </div>
    <a asp-action="Create" class="btn text-white fw-bold rounded-3 px-4 text-nowrap" style="background-color: #2e7d32;">
        + Create New
    </a>
</div>

<!-- ORDERS TABLE CARD -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="text-uppercase fs-7 fw-bold text-muted" style="background-color: #f8fbf7;">
                <tr>
                    <th class="ps-4 py-3 text-nowrap">Order #</th>
                    <th class="py-3 text-nowrap">Customer</th>
                    <th class="py-3 text-nowrap">Amount</th>
                    <th class="py-3 text-center text-nowrap">Order Status</th>
                    <th class="py-3 text-center text-nowrap">Payment</th>
                    <th class="py-3 text-nowrap">Date</th>
                    <th class="py-3 text-end pe-4 text-nowrap">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <h6 class="fw-semibold mb-1">No Orders Found</h6>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- ORDER NUMBER -->
                            <td class="ps-4 py-3 text-nowrap">
                                <span class="fw-bold text-dark">
                                    @(string.IsNullOrEmpty(item.OrderNumber) ? $"#{item.OrderID}" : item.OrderNumber)
                                </span>
                            </td>

                            <!-- CUSTOMER -->
                            <td class="py-3 text-nowrap">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle text-success fw-bold d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width: 32px; height: 32px; background-color: #eaf5e9; font-size: 0.85rem;">
                                        @(item.users?.FullName != null ? item.users.FullName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <span class="fw-semibold text-dark fs-7">
                                        @(item.users?.FullName ?? $"User #{item.UserID}")
                                    </span>
                                </div>
                            </td>

                            <!-- AMOUNT -->
                            <td class="py-3 text-nowrap fw-bold" style="color: #2e7d32;">
                                $@item.TotalAmount
                            </td>

                            <!-- ORDER STATUS -->
                            <td class="py-3 text-center text-nowrap">
                                <span class="badge rounded-pill px-3 py-1 fw-semibold text-capitalize fs-7"
                                      style="background-color: #eaf5e9; color: #2e7d32; border: 1px solid #d4ebd2;">
                                    @(string.IsNullOrWhiteSpace(item.Orderstatus) ? "Pending" : item.Orderstatus)
                                </span>
                            </td>

                            <!-- PAYMENT STATUS -->
                            <td class="py-3 text-center text-nowrap">
                                <span class="badge rounded-pill px-3 py-1 fw-semibold text-capitalize fs-7"
                                      style="background-color: #f6fbf5; color: #388e3c; border: 1px solid #e0f2df;">
                                    @(string.IsNullOrWhiteSpace(item.PaymentStatus) ? "Pending" : item.PaymentStatus)
                                </span>
                            </td>

                            <!-- CREATED DATE -->
                            <td class="py-3 text-muted fs-7 text-nowrap">
                                @(item.createdat.ToString("g") ?? "—")
                            </td>

                            <!-- ACTIONS -->
                            <td class="py-3 text-end pe-4 text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.OrderID" class="btn btn-sm btn-light border text-info px-2 py-1 fs-7">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.OrderID" class="btn btn-sm btn-light border text-danger px-2 py-1 fs-7">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>