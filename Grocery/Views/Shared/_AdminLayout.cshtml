<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZARMED Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
</head>
<body class="bg-light text-dark min-vh-100 d-flex flex-column">

    <!-- TOP NAVIGATION BAR START -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-2 px-3 shadow-sm">
        <div class="container-fluid px-0">
            <!-- Brand Logo -->
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-success me-4" asp-controller="Admin" asp-action="Index">
                <div class="bg-success text-white p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="ti ti-activity-heartbeat fs-4"></i>
                </div>
                <span class="fs-4 tracking-tight">ZARMED</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavbar">
                <!-- Search Box -->
                <div class="ms-lg-4 me-auto my-2 my-lg-0 w-100 max-w-md">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-pill-start ps-3 text-muted">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control bg-light border-start-0 rounded-pill-end shadow-none" placeholder="Search products, orders, stock...">
                    </div>
                </div>

                <!-- Right Top Menu Items -->
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <a href="#" class="btn btn-light rounded-circle p-2 position-relative shadow-xs border">
                        <i class="ti ti-bell fs-5 text-secondary"></i>
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                            <span class="visually-hidden">New alerts</span>
                        </span>
                    </a>

                    <a href="#" class="btn btn-light rounded-circle p-2 shadow-xs border">
                        <i class="ti ti-shopping-bag fs-5 text-secondary"></i>
                    </a>

                    <div class="vr mx-1 d-none d-lg-block"></div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle text-dark" data-bs-toggle="dropdown">
                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" class="rounded-circle border border-success" width="38" height="38" alt="Profile">
                            <span class="fw-semibold d-none d-md-inline">Ali</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                            <li><a class="dropdown-menu-item dropdown-item d-flex align-items-center gap-2 py-2" href="#"><i class="ti ti-user text-muted"></i> Profile</a></li>
                            <li><a class="dropdown-menu-item dropdown-item d-flex align-items-center gap-2 py-2" href="#"><i class="ti ti-settings text-muted"></i> Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-menu-item dropdown-item text-danger d-flex align-items-center gap-2 py-2" asp-controller="User" asp-action="Logout"><i class="ti ti-logout"></i> Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <!-- TOP NAVIGATION BAR END -->


    <!-- FULL WIDTH MAIN BODY WRAPPER START -->
    <div class="container-fluid px-3 px-md-4 py-4 flex-grow-1">
        <div class="row g-4">

            <!-- SIDEBAR MENU START -->
            <aside class="col-12 col-md-3 col-xl-2">
                <div class="bg-white rounded-4 p-3 shadow-sm border border-light-subtle position-sticky" style="top: 5rem;">

                    <div class="p-3 bg-success-subtle text-success rounded-3 mb-4 d-flex align-items-center gap-2 fw-bold">
                        <i class="ti ti-layout-grid fs-5"></i>
                        <span>Panel</span>
                    </div>

                    <nav class="nav nav-pills flex-column gap-1 mb-4">
                        <a asp-controller="Admin" asp-action="Index" class="nav-link text-dark fw-medium d-flex align-items-center gap-2 rounded-3 py-2 px-3 hover-bg-light">
                            <i class="ti ti-layout-dashboard text-secondary fs-5"></i>
                            <span>Dashboard</span>
                        </a>
                    </nav>

                    <!-- GROUP 1: PRODUCT AND STOCK -->
                    <small class="text-uppercase fw-bold text-muted fs-8 tracking-wider d-block mb-2 px-2">Product and Stock</small>
                    <nav class="nav nav-pills flex-column gap-1 mb-4">
                        <a asp-controller="Products" asp-action="View_Products" class="nav-link text-dark fw-medium d-flex align-items-center gap-2 rounded-3 py-2 px-3 hover-bg-light">
                            <i class="ti ti-package text-secondary fs-5"></i>
                            <span>Products</span>
                        </a>
                        <a asp-controller="Categories" asp-action="View_category" class="nav-link text-dark fw-medium d-flex align-items-center gap-2 rounded-3 py-2 px-3 hover-bg-light">
                            <i class="ti ti-category text-secondary fs-5"></i>
                            <span>Categories</span>
                        </a>
                        <a asp-controller="User" asp-action="View_Users" class="nav-link text-dark fw-medium d-flex align-items-center gap-2 rounded-3 py-2 px-3 hover-bg-light">
                            <i class="ti ti-user text-secondary fs-5"></i>
                            <span>Users</span>
                        </a>
                        <a asp-controller="Order" asp-action="View_Orders" class="nav-link text-dark fw-medium d-flex align-items-center gap-2 rounded-3 py-2 px-3 hover-bg-light">
                            <i class="ti ti-shopping-cart text-secondary fs-5"></i>
                            <span>Orders</span>
                        </a>
                    </nav>

                </div>
            </aside>
            <!-- SIDEBAR MENU END -->
            <!-- DYNAMIC MAIN CONTENT INJECTED HERE -->
            <main class="col-12 col-md-9 col-xl-10">
                @RenderBody()
            </main>

        </div>
    </div>
    <!-- FULL WIDTH MAIN BODY WRAPPER END -->
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>