```cshtml
@model Grocery.Models.Products

@{
    ViewData["Title"] = "ProductDetails";
}


<div class="container">


    <!-- Breadcrumb -->
    <div class="mb-4">

        <small class="text-muted">
            Home / @Model.categories.CategoryName / @Model.ProductName
        </small>

    </div>




    <!-- Main Product -->

    <div class="row g-5 align-items-center">


        <!-- Image -->

        <div class="col-lg-6">

            <div class="border d-flex justify-content-center rounded p-4 text-center">

                <img src="~/All_Images/Products/@Model.Image" class="img-fluid" style="height:450px; object-fit:contain;" alt="@Model.ProductName">

            </div>

        </div>





        <!-- Details -->

        <div class="col-lg-6">


            <span class="text-success">
                @Model.categories.CategoryName
            </span>



            <h1 class="fw-bold mt-2">

                @Model.ProductName

            </h1>




            <div class="mb-3">

                <span class="text-warning fs-5">
                    ★★★★★
                </span>


                <span class="text-muted">
                    (120 Reviews)
                </span>


            </div>





            <h2 class="fw-bold text-success">

                $@Model.Price

            </h2>





            <p class="text-muted mt-3">

                @Model.Description

            </p>






            <!-- Quantity -->

            <div class="d-flex align-items-center gap-3 my-4">


                <strong>
                    Quantity
                </strong>


                <button class="btn btn-outline-secondary btn-sm" onclick="decrease_quantity()">
                    -
                </button>



                <input type="text" value="1" id="quantity" class="form-control text-center" style="width:60px;">



                <button class="btn btn-outline-secondary btn-sm" onclick="increase_quantity()">
                    +
                </button>


            </div>






            <!-- Buttons -->


            <div class="d-flex gap-3">


                <button class="btn btn-success btn-lg px-5">

                    Add To Cart

                </button>



                <button class="btn btn-warning btn-lg px-5">

                    Buy Now

                </button>



            </div>






            <!-- Delivery -->


            <div class="mt-5">


                <div class="border rounded p-3">


                    <h5>
                        🚚 Delivery
                    </h5>



                    <p class="mb-0 text-muted">

                        Delivered within 3-5 working days.

                    </p>


                </div>


            </div>



        </div>



    </div>







    <!-- Description -->


    <div class="mt-5">


        <div class="card shadow-sm">


            <div class="card-body">


                <h3 class="fw-bold">

                    Product Description

                </h3>




                <p class="text-muted mt-3">

                    @Model.Description

                </p>



            </div>


        </div>


    </div>







    <!-- Related Products -->


    <section class="mt-5">


        <h3 class="fw-bold mb-4">

            Related Products

        </h3>





        <div class="row g-4">


            @if (ViewBag.randomproducts != null)
            {

                foreach (var item in ViewBag.randomproducts)
                {


                    <div class="col-lg-3 col-md-6">


                        <div class="card shadow-sm" style="height:280px; width:280px;">


                            <div class="card-body">



                                <div class="text-center d-flex justify-content-center align-items-center" style="height:160px;">

                                    <img src="~/All_Images/Products/@item.Image" class="img-fluid" style="height:160px; object-fit:contain;">

                                </div>




                                <h6 class="mt-3">

                                    @item.ProductName

                                </h6>




                                <strong>

                                    $@item.Price

                                </strong>





                                <a asp-action="ProductDetails" asp-route-id="@item.ProductID" class="btn btn-success btn-sm w-100 mt-2">

                                    View Product

                                </a>




                            </div>


                        </div>


                    </div>


                }

            }



        </div>



    </section>





</div>

<script>

    function increase_quantity() {

        let quantity = document.getElementById("quantity");
        let value = parseInt(quantity.value);
        value++;

        quantity.value = value;
    }

    function decrease_quantity() {

        let quantity = document.getElementById("quantity");
        let value = parseInt(quantity.value);

        if (value > 0) {
            value--;
            quantity.value = value;
        }

    }

</script>
```
