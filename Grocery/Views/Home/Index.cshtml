<!-- MAIN CONTENT START -->
<main>
    <!-- HERO / HEADER SLIDER SECTION START -->
    <section class="mt-8">
        <div class="container">
            <div class="swiper-container swiper" data-autoplay="true" data-autoplay-delay="3000"
                 data-breakpoints='{"480": {"slidesPerView": 1}, "768": {"slidesPerView": 1}, "1024": {"slidesPerView": 1}}'
                 data-effect="fade" data-navigation="false" data-pagination="true" data-pagination-type=""
                 data-space-between="100" data-speed="400" id="hero-slider">
                <div class="swiper-wrapper pb-8">
                    <div class="swiper-slide"
                         style="background: url('@Url.Content("~/images/slider/slide-1.jpg")') no-repeat; background-size: cover; border-radius: 0.5rem; background-position: center">
                        <div class="lg:py-32 p-12 lg:pl-12 xl:w-2/5 md:w-3/5">
                            <span class="inline-block p-2 text-sm align-baseline leading-none rounded-lg bg-yellow-500 text-gray-900 font-semibold">
                                Opening
                                Sale Discount 50%
                            </span>
                            <div class="my-7 flex flex-col gap-2">
                                <h1 class="text-gray-900 text-xl lg:text-5xl font-bold leading-tight">
                                    SuperMarket
                                    For Fresh Grocery
                                </h1>
                                <p class="text-md font-light">
                                    Introduced a new model for online grocery shopping and
                                    convenient home
                                    delivery.
                                </p>
                            </div>
                            <a class="btn inline-flex items-center gap-x-2 bg-gray-800 text-white border-gray-800 disabled:opacity-50 disabled:pointer-events-none hover:text-white hover:bg-gray-900 hover:border-gray-900 active:bg-gray-900 active:border-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300"
                               href="#">
                                Shop Now
                                <i class="ti ti-arrow-right inline-block"
                                   style="font-size:14px; line-height:14px;"></i>
                            </a>
                        </div>
                    </div>
                    <div class="swiper-slide"
                         style="background: url('@Url.Content("~/images/slider/slider-2.jpg")') no-repeat; background-size: cover; border-radius: 0.5rem; background-position: center">
                        <div class="lg:py-32 lg:pl-12 lg:pr-6 px-12 py-12 xl:w-2/5 md:w-3/5">
                            <span class="inline-block p-2 text-sm align-baseline leading-none rounded-lg bg-yellow-500 text-gray-900 font-semibold">
                                Free
                                Shipping - orders over $100
                            </span>
                            <div class="my-7 flex flex-col gap-2">
                                <h2 class="text-gray-900 text-xl lg:text-5xl font-bold leading-tight">
                                    Free Shipping on
                                    <br />
                                    orders over
                                    <span class="text-green-600">$100</span>
                                </h2>
                                <p class="text-md font-light">
                                    Free Shipping to First-Time Customers Only, After
                                    promotions and
                                    discounts are applied.
                                </p>
                            </div>
                            <a class="btn inline-flex items-center gap-x-2 bg-gray-800 text-white border-gray-800 disabled:opacity-50 disabled:pointer-events-none hover:text-white hover:bg-gray-900 hover:border-gray-900 active:bg-gray-900 active:border-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300"
                               href="#">
                                Shop Now
                                <i class="ti ti-arrow-right inline-block"
                                   style="font-size:14px; line-height:14px;"></i>
                            </a>
                        </div>
                    </div>
                    <!-- Add more slides as needed -->
                </div>
                <!-- Add Pagination -->
                <div class="swiper-pagination !bottom-14"></div>
                <!-- Add Navigation -->
                <div class="swiper-navigation">
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                </div>
            </div>
        </div>
    </section>
    <!-- HERO / HEADER SLIDER SECTION END -->


    <!-- FEATURED CATEGORIES SECTION START -->
    
    <section class="mt-8">
        <div class="container mx-auto">

            <!-- Heading + Arrows -->
            <div class="flex items-center justify-between mb-5">

                <h4 class="text-2xl font-semibold text-slate-800">
                    Featured Categories
                </h4>

                <div class="flex gap-3">
                    <div class="swiper-button-prev !static !m-0 !w-10 !h-10 rounded-full bg-gray-100 shadow-sm"></div>
                    <div class="swiper-button-next !static !m-0 !w-10 !h-10 rounded-full bg-gray-100 shadow-sm"></div>
                </div>

            </div>


            <!-- Swiper -->
            <div class="swiper categoriesSwiper overflow-hidden mb-5">

                <div class="swiper-wrapper">

                    @foreach (var item in ViewBag.category)
                    {
                        <div class="swiper-slide !h-auto">

                            <a href="#" class="block h-full">

                                <div class="rounded-lg border border-gray-200 bg-white
                                    hover:border-green-500 hover:shadow-md transition" style="height:210px; width:190px;">

                                    <!-- Image -->
                                    <div class="h-[200px] w-full flex items-center justify-center px-4 pt-4">
                                        <img src="~/All_Images/Categories/@item.image"
                                             class="object-contain"
                                             alt="@item.CategoryName" />
                                    </div>

                                    <!-- Category Name -->
                                    <div class="h-[60px] flex items-center justify-center px-2 mt-4">

                                        <span class="text-base font-medium text-gray-600 text-center leading-5">
