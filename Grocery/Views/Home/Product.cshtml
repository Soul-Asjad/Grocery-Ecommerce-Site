@{
    ViewData["Title"] = "Products";
}


<div class="container py-4">


    <!-- Top Header -->

    <div class="row align-items-center mb-4">


        <div class="col-lg-7">

            <h2 class="fw-bold mb-1">
                Shop All Products
            </h2>

            <p class="text-muted mb-0">
                Fresh groceries delivered to your door
            </p>

        </div>

        <div class="col-lg-5">
            <div class="d-flex">

                <input type="text"
                       class="form-control rounded-start-pill"
                       placeholder="Search products..."
                       style="height:45px;">


                <button class="btn btn-success rounded-end-pill px-4"
                        style="height:45px;">
                    Search
                </button>

            </div>
        </div>


    </div>







    <div class="row g-4">



        <!-- Sidebar -->


        <div class="col-lg-3">


            <div class="card shadow-sm border-0">


                <div class="card-body">


                    <h5 class="fw-bold mb-4">
                        Categories
                    </h5>



                    <ul class="list-group list-group-flush">


                        <li class="list-group-item px-0">
                            Fruits
                        </li>


                        <li class="list-group-item px-0">
                            Vegetables
                        </li>


                        <li class="list-group-item px-0">
                            Dairy Products
                        </li>


                        <li class="list-group-item px-0">
                            Drinks
                        </li>


                        <li class="list-group-item px-0">
                            Snacks
                        </li>


                    </ul>




                    <hr>




                    <h5 class="fw-bold">
                        Price
                    </h5>


                    <input type="range"
                           class="form-range">



                </div>


            </div>



        </div>









        <!-- Product Grid -->


        <div class="col-lg-9">


            <div class="d-flex justify-content-between mb-3">


                <span class="text-muted">
                    Showing @ViewBag.products.Count Products
                </span>



                <select class="form-select"
                        style="width:180px;">

                    <option>
                        Sort By
                    </option>

                    <option>
                        Price Low
                    </option>

                    <option>
                        Price High
                    </option>

                </select>


            </div>





            <div class="row g-4">





                <!-- Product Card -->
                @foreach (var item in ViewBag.products)
                {
                    <div class="col-xl-4 col-md-6">


                        <div class="card h-100 shadow-sm border-0">


                            <div class="card-body p-3">


                                <span class="badge bg-danger">
                                    Sale
                                </span>



                                <div class="d-flex justify-content-center align-items-center my-3"
                                     style="height:170px;">

                                    <img src="~/All_Images/Products/@item.Image"
                                         class="img-fluid"
                                         style="max-height:170px; max-width:100%; object-fit:contain;">

                                </div>





                                <small class="text-muted">
                                    @item.categories.CategoryName
                                </small>



                                <h5 class="fw-bold mt-2">
                                    @item.ProductName
                                </h5>




                                <div class="mb-2">

                                    <span class="text-warning">
                                        ★★★★★
                                    </span>

                                    <small class="text-muted">
                                        (120)
                                    </small>

                                </div>





                                <div class="d-flex justify-content-between align-items-center">


                                    <h5 class="text-success fw-bold mb-0">
                                        @item.Price
                                    </h5>



                                    <a class="btn btn-success btn-sm" asp-action="ProductDetails" asp-route-id="@item.ProductID"> <i class="ti ti-plus"></i> Add </a>


                                </div>



                            </div>


                        </div>


                    </div>
                }



            </div>


        </div>


    </div>






    <!-- Pagination -->


    <div class="d-flex justify-content-center mt-5">

        <nav>
            <ul class="pagination">

                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Product"
                           asp-route-page="@(ViewBag.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                        <a class="page-link"
                           asp-action="Product"
                           asp-route-page="@i">
                            @i
                        </a>

                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Product"
                           asp-route-page="@(ViewBag.CurrentPage + 1)">
                            Next
                        </a>
                    </li>
                }

            </ul>
        </nav>

    </div>



</div>