@model Grocery.Models.Contact

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact Details";
}

<div class="container-fluid py-4 px-3 px-lg-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Message Details</h2>
            <p class="text-secondary mb-0">
                View the complete details of a customer inquiry.
            </p>
        </div>

        <a asp-action="ContactMessages" class="btn btn-outline-success rounded-3 px-4"> 
            &larr; Back to Messages
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">

                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 85px; height: 85px; background-color: #e8f9e9;">
                        <span class="fs-1 fw-bold text-success">
                            @(string.IsNullOrWhiteSpace(Model.FullName)
                                ? "?"
                                : Model.FullName.Substring(0, 1).ToUpper())
                        </span>
                    </div>

                    <h4 class="fw-bold mb-1">@Model.FullName</h4>

                    <p class="text-secondary mb-3">@Model.Email</p>

                    <span class="badge rounded-pill px-3 py-2"
                          style="background-color: #e8f9e9; color: #218838;">
                        Customer Inquiry
                    </span>

                    <hr class="my-4" />

                    <div class="text-start">
                        <p class="text-secondary small mb-1">Customer Name</p>
                        <p class="fw-semibold mb-3">@Model.FullName</p>

                        <p class="text-secondary small mb-1">Email Address</p>
                        <p class="fw-semibold mb-0 text-break">@Model.Email</p>
                    </div>

                </div>
            </div>
        </div>

        <!-- Message Information -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-1">Customer Message</h5>
                    <p class="text-secondary small mb-0">
                        Inquiry information submitted through the contact page.
                    </p>
                </div>

                <div class="card-body px-4 pb-4">

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-semibold">
                            SUBJECT
                        </label>
                        <div class="border rounded-3 p-3">
                            <span class="fw-semibold">@Model.Subject</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-semibold">
                            MESSAGE
                        </label>
                        <div class="border rounded-3 p-3"
                             style="min-height: 200px; white-space: pre-wrap; overflow-wrap: anywhere;">
                            @Model.Message
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2">

                        <a asp-action="ContactMessages"
                           class="btn btn-success rounded-3 px-4">
                            Back to Messages
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.ContactID"
                           class="btn btn-outline-danger rounded-3 px-4">
                            Delete Message
                        </a>

                    </div>

                </div>
            </div>
        </div>

    </div>
</div>
