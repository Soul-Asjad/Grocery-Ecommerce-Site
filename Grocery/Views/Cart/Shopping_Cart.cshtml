@{
    ViewData["Title"] = "Shopping_Cart";
    decimal sub_total = 0;
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold mb-1">
                Shopping Cart
            </h2>

            <p class="text-muted mb-0">
                Review your products before checkout
            </p>
        </div>
    </div>


    <div class="row g-4">

        <!-- CART PRODUCTS -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h5 class="fw-bold mb-0">
                            Your Cart
                        </h5>

                        <span class="text-muted">
                            @ViewBag.count Items
                        </span>

                    </div>


                    <!-- CART ITEMS -->
                    @foreach (var item in Model)
                    {
                        var total = item.products.Price * item.Quantity;
                        sub_total = total + sub_total;

                        <div class="row align-items-center border-bottom pb-4 mb-4">

                            <!-- Image -->
                            <div class="col-3 col-md-2">

                                <div class="bg-light rounded p-2 text-center"
                                     style="height:90px;">

                                    <img src="~/All_Images/Products/@item.products.Image"
                                         class="img-fluid h-100"
                                         style="object-fit:contain;">

                                </div>

                            </div>


                            <!-- Product Info -->
                            <div class="col-9 col-md-4">

                                <small class="text-muted">
                                    @item.products.categories.CategoryName
                                </small>

                                <h6 class="fw-bold mb-1">
                                    @item.products.ProductName
                                </h6>

                                <span class="text-success fw-bold">
                                    $@item.products.Price
                                </span>

                            </div>


                            <!-- Quantity -->
                            <div class="col-6 col-md-3 mt-3 mt-md-0">

                                <div class="input-group input-group-sm">

                                    <!-- Minus -->
                                    <button type="button"
                                            class="btn btn-outline-secondary qty-btn"
                                            data-id="@item.CartItemID"
                                            data-change="-1"
                                        @(item.Quantity <= 1 ? "disabled" : "")>
                                        −
                                    </button>


                                    <!-- Quantity -->
                                    <input type="text"
                                           id="qty-@item.CartItemID"
                                           class="form-control text-center"
                                           value="@item.Quantity"
                                           readonly />


                                    <!-- Plus -->
                                    <button type="button"
                                            class="btn btn-outline-secondary qty-btn"
                                            data-id="@item.CartItemID"
                                            data-change="1">
                                        +
                                    </button>

                                </div>

                            </div>


                            <!-- Total + Remove -->
                            <div class="col-6 col-md-3 text-end mt-3 mt-md-0">

                                <h6 class="fw-bold mb-2" id="total-@item.CartItemID">
                                    $@total
                                </h6>

                                <a class="btn btn-sm btn-outline-danger" asp-action="Remove" asp-controller="Cart" asp-route-id="@item.CartItemID">
                                    <i class="ti ti-trash"></i>
                                    Remove
                                </a>

                            </div>

                        </div>
                    }


                    <!-- Continue Shopping -->
                    <div class="mt-4 pt-4 border-top">

                        <a asp-action="Product"
                           asp-controller="Home"
                           class="btn btn-outline-success">

                            <i class="ti ti-arrow-left"></i>
                            Continue Shopping

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- CART SUMMARY -->
        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Cart Summary
                    </h5>


                    <!-- Subtotal -->
                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Subtotal
                        </span>

                        <span class="fw-semibold" id="subtotal">
                            $@sub_total
                        </span>

                    </div>


                    <!-- Delivery -->
                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Delivery
                        </span>

                        <span class="fw-semibold">
                            $2.00
                        </span>

                    </div>


                    <hr>


                    <!-- Total -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <span class="fw-bold">
                            Total
                        </span>

                        <h4 class="text-success fw-bold mb-0" id="cart-total">
                            $@(sub_total + 2)
                        </h4>

                    </div>


                    <!-- Checkout -->
                    <a class="btn btn-success w-100 py-2 mb-3" asp-action="Checkout" asp-controller="Checkout">

                        Proceed to Checkout
                        <i class="ti ti-arrow-right ms-1"></i>

                    </a>


                    <div class="text-center">

                        <small class="text-muted">
                            Secure checkout • Fast delivery
                        </small>

                    </div>

                </div>

            </div>


            <!-- Promo Code -->
            <div class="card shadow-sm border-0 mt-4">

                <div class="card-body p-4">

                    <h6 class="fw-bold mb-3">
                        Have a Promo Code?
                    </h6>

                    <div class="input-group">

                        <input type="text"
                               class="form-control"
                               placeholder="Enter code">

                        <button class="btn btn-outline-success">
                            Apply
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


 <script>
    async function updateQuantity(btn) {
        const id = btn.dataset.id;
        const qtyInput = document.getElementById('qty-' + id);
        let newQty = parseInt(qtyInput.value) + parseInt(btn.dataset.change);
        if (newQty < 1) newQty = 1;

        const res = await fetch('/Cart/UpdateQuantity', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}&quantity=${newQty}`
        });

        if (!res.ok) return;
        const data = await res.json();

        qtyInput.value = data.quantity;
        document.getElementById('total-' + id).textContent = '$' + data.itemTotal.toFixed(2);
        document.getElementById('subtotal').textContent = '$' + data.subtotal.toFixed(2);
        document.getElementById('cart-total').textContent = '$' + data.total.toFixed(2);

        document.querySelector(`.qty-btn[data-id="${id}"][data-change="-1"]`).disabled = data.quantity <= 1;
    }

    document.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', () => updateQuantity(btn));
    });
</script>