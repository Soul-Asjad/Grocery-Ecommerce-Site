@model IEnumerable<Grocery.Models.Categories>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories List";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-success mb-1">Category Inventory</h2>
        <small class="text-muted">Manage your store product categories.</small>
    </div>
    <a asp-action="Add_category" class="btn btn-success btn-lg fw-bold rounded-3 px-4 text-nowrap">
        + Add New Category
    </a>
</div>

<!-- CATEGORIES TABLE CARD -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase fs-7 fw-bold text-muted">
                <tr>
                    <th class="ps-4 py-3 text-nowrap">Category</th>
                    <th class="py-3 text-nowrap">Description</th>
                    <th class="py-3 text-center text-nowrap">Status</th>
                    <th class="py-3 text-nowrap">Created At</th>
                    <th class="py-3 text-end pe-4 text-nowrap">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <h6 class="fw-semibold mb-1">No Categories Found</h6>
                            <small>Click "+ Add New Category" to create your first category.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- CATEGORY IMAGE & NAME -->
                            <td class="ps-4 py-3 text-nowrap">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="~/All_Images/Categories/@item.image"
                                         alt="@item.CategoryName"
                                         class="rounded-3 border flex-shrink-0"
                                         style="width: 48px; height: 48px; object-fit: cover;"
                                         onerror="this.src='https://placehold.co/48x48?text=Cat';" />
                                    <h6 class="fw-bold text-dark mb-0 text-nowrap">@item.CategoryName</h6>
                                </div>
                            </td>

                            <!-- DESCRIPTION -->
                            <td class="py-3">
                                <small class="text-muted d-block text-truncate" style="max-width: 320px;">
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "No description"
                                        : string.Join(" ", item.Description.Split(' ').Take(8)) + "...")
                                </small>
                            </td>

                            <!-- STATUS -->
                            <td class="py-3 text-center text-nowrap">
                                @if (item.isactive == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <!-- CREATED AT -->
                            <td class="py-3 text-muted fs-7 text-nowrap">
                                @(item.createdat.ToString("MMM dd, yyyy") ?? "—")
                            </td>

                            <!-- ACTIONS IN ONE LINE -->
                            <td class="py-3 text-end pe-4 text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Categoryid" class="btn btn-sm btn-light border text-primary px-2">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Categoryid" class="btn btn-sm btn-light border text-info px-2">View</a>
                                    <a asp-action="Delete" asp-route-id="@item.Categoryid" class="btn btn-sm btn-light border text-danger px-2">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>