@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
    var username = Context.Session.GetString("user");
}

<!-- GREETING BANNER -->
<div class="mb-4">
    <h2 class="fw-bold text-success mb-0">Hello!</h2>
    <h5 class="fw-semibold text-dark">@username</h5>
</div>

<!-- OVERVIEW SECTION -->
<div class="mb-5">
    <h5 class="fw-bold text-dark mb-3">Overview</h5>
    <div class="row g-3">
        <!-- Card 1 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 text-white shadow-sm h-100" style="background: linear-gradient(135deg, #1b5e20 0%, #4caf50 100%);">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-white rounded-circle p-3 text-success d-flex align-items-center justify-content-center shadow-xs" style="width: 52px; height: 52px;">
                        <i class="ti ti-currency-dollar fs-3"></i>
                    </div>
                    <div>
                        <small class="text-white-50 fw-semibold d-block">Total Earnings</small>
                        <h4 class="fw-bold mb-0">$ @ViewBag.TotalEarn</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 text-white shadow-sm h-100" style="background: linear-gradient(135deg, #2e7d32 0%, #66bb6a 100%);">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-white rounded-circle p-3 text-success d-flex align-items-center justify-content-center shadow-xs" style="width: 52px; height: 52px;">
                        <i class="ti ti-box fs-3"></i>
                    </div>
                    <div>
                        <small class="text-white-50 fw-semibold d-block">Total Orders</small>
                        <h4 class="fw-bold mb-0">@ViewBag.Orders</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 text-white shadow-sm h-100" style="background: linear-gradient(135deg, #33691e 0%, #8bc34a 100%);">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-white rounded-circle p-3 text-success d-flex align-items-center justify-content-center shadow-xs" style="width: 52px; height: 52px;">
                        <i class="ti ti-users fs-3"></i>
                    </div>
                    <div>
                        <small class="text-white-50 fw-semibold d-block">Total Customers</small>
                        <h4 class="fw-bold mb-0">@ViewBag.users</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 text-white shadow-sm h-100" style="background: linear-gradient(135deg, #558b2f 0%, #9ccc65 100%);">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-white rounded-circle p-3 text-success d-flex align-items-center justify-content-center shadow-xs" style="width: 52px; height: 52px;">
                        <i class="ti ti-file-text fs-3"></i>
                    </div>
                    <div>
                        <small class="text-white-50 fw-semibold d-block">Total Products</small>
                        <h4 class="fw-bold mb-0">@ViewBag.products</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ORDER STATISTICS SECTION -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">Order Statistics</h5>
        <select class="form-select form-select-sm w-auto rounded-pill border-0 shadow-sm px-3 py-2 fw-semibold">
            <option>Select Period</option>
            <option>Today</option>
            <option>This Week</option>
            <option>This Month</option>
        </select>
    </div>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-package fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">Total Orders</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-clock fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">Pending</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-circle-check fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">Confirmed</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-info-subtle text-info p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-truck-delivery fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">In Progress</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-check fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">Delivered</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-x fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">Canceled</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-secondary-subtle text-secondary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-arrow-back-up fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">Returned</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="ti ti-ban fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-semibold d-block">Rejected</small>
                        <h5 class="fw-bold mb-0 text-dark">0</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RECENT ORDERS TABLE SECTION -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">Recent Orders</h5>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3">View All</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3 py-3">Order ID</th>
                    <th class="py-3">Customer</th>
                    <th class="py-3">Amount</th>
                    <th class="py-3">Status</th>
                    <th class="py-3 text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        <i class="ti ti-inbox fs-1 d-block mb-2 text-secondary"></i>
                        <span>No recent orders found.</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>