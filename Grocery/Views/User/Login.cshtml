@model Grocery.Models.Users

@{
    ViewData["Title"] = "Login";
}

<div class="login-page my-5">

    <div class="login-container">

        <!-- Left Side Content -->
        <div class="login-info">
            <div class="brand-box">
                <h2>FreshCart</h2>
                <p>Fresh groceries delivered to your doorstep.</p>
            </div>

            <div class="info-content">
                <h1>Welcome Back</h1>
                <p>
                    Login to your account and continue shopping fresh fruits,
                    vegetables, dairy products, snacks and daily grocery items.
                </p>

                <div class="benefits">
                    <div class="benefit-item">
                        <span>✓</span>
                        <p>Manage your orders easily</p>
                    </div>

                    <div class="benefit-item">
                        <span>✓</span>
                        <p>Track your grocery delivery</p>
                    </div>

                    <div class="benefit-item">
                        <span>✓</span>
                        <p>Continue your shopping cart</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side Form -->
        <div class="login-card">
            <div class="form-header">
                <h3>Login</h3>
                <p>Enter your email and password to access your account.</p>
            </div>

            <form asp-action="Login" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="email">Email Address</label>
                    <input asp-for="email" class="form-control" placeholder="Enter your email address" />
                    <span asp-validation-for="email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="login-btn">
                    Login
                </button>

                <div class="form-footer">
                    <p>
                        Don’t have an account?
                        <a asp-action="Create">Create Account</a>
                    </p>

                    <a asp-controller="Home" asp-action="Index" class="back-home">
                        Back to Home
                    </a>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}