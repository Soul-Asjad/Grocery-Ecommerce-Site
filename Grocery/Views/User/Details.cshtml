@model Grocery.Models.Users

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Details";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-success mb-1">User Profile Details</h2>
        <small class="text-muted">Viewing details for account "@Model.FullName"</small>
    </div>
    <div class="d-flex gap-2 text-nowrap">
        <a asp-action="Edit" asp-route-id="@Model?.Userid" class="btn btn-primary fw-bold rounded-3 px-4">
            Edit Profile
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">
            Back to List
        </a>
    </div>
</div>

<!-- DETAILS CONTAINER -->
<div class="row g-4">

    <!-- LEFT COLUMN: USER AVATAR & QUICK STATUS -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 text-center mb-4">
            <!-- AVATAR INITIAL -->
            <div class="rounded-circle bg-success-subtle text-success fw-bold mx-auto mb-3 d-flex align-items-center justify-content-center border border-success-subtle"
                 style="width: 100px; height: 100px; font-size: 2.5rem;">
                @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
            </div>

            <h5 class="fw-bold text-dark mb-1">@Model.FullName</h5>
            <p class="text-muted fs-7 mb-3">@(string.IsNullOrWhiteSpace(Model.email) ? "No Email Registered" : Model.email)</p>

            <div class="d-flex justify-content-center gap-2 mb-2">
                <!-- ROLE BADGE -->
                @if (!string.IsNullOrEmpty(Model.role) && Model.role.ToLower().Contains("admin"))
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 text-capitalize">
                        @Model.role
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1 text-capitalize">
                        @(string.IsNullOrWhiteSpace(Model.role) ? "User" : Model.role)
                    </span>
                }

                <!-- ACTIVE STATUS BADGE -->
                @if (Model.isactive == "active")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                        Active Account
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                        Inactive
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: DETAILED INFORMATION -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold text-dark mb-0">Account Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">

                    <!-- FULL NAME -->
                    <div class="col-12 col-md-6">
                        <label class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Full Name</label>
                        <p class="fw-bold text-dark mb-0">@Model.FullName</p>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-12 col-md-6">
                        <label class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Email Address</label>
                        <p class="fw-bold text-dark mb-0">@(string.IsNullOrWhiteSpace(Model.email) ? "—" : Model.email)</p>
                    </div>

                    <div class="col-12"><hr class="my-2 text-light-subtle"></div>

                    <!-- PHONE -->
                    <div class="col-12 col-md-6">
                        <label class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Phone Number</label>
                        <p class="fw-semibold text-secondary mb-0">@(string.IsNullOrWhiteSpace(Model.phone) ? "—" : Model.phone)</p>
                    </div>

                    <!-- ASSIGNED ROLE -->
                    <div class="col-12 col-md-6">
                        <label class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Role</label>
                        <p class="fw-semibold text-secondary text-capitalize mb-0">@(string.IsNullOrWhiteSpace(Model.role) ? "User" : Model.role)</p>
                    </div>

                    <div class="col-12"><hr class="my-2 text-light-subtle"></div>

                    <!-- PASSWORD (PROTECTED / MASKED) -->
                    <div class="col-12 col-md-6">
                        <label class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Password</label>
                        <p class="text-secondary mb-0">••••••••••••</p>
                    </div>

                    <!-- CREATED DATE -->
                    <div class="col-12 col-md-6">
                        <label class="text-uppercase fs-7 fw-bold text-muted d-block mb-1">Account Created Date</label>
                        <p class="fw-semibold text-dark mb-0">
                            @(Model.createdate.ToString("MMMM dd, yyyy") ?? "—")
                        </p>
                    </div>

                </div>
            </div>

            <!-- FOOTER ACTIONS -->
            <div class="card-footer bg-light border-top p-3 text-end rounded-bottom-4">
                <a asp-action="Edit" asp-route-id="@Model?.Userid" class="btn btn-primary fw-bold px-4 me-2">Edit Account</a>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
            </div>
        </div>
    </div>

</div>