@model Grocery.Models.Users

@{
    ViewData["Title"] = "Sign Up";
}

<div class="signup-page my-5">

    <div class="signup-container">

        <!-- Left Side Content -->
        <div class="signup-info">
            <div class="brand-box">
                <h2>FreshCart</h2>
                <p>Fresh groceries delivered to your doorstep.</p>
            </div>

            <div class="info-content">
                <h1>Create Your Account</h1>
                <p>
                    Sign up now and start shopping fresh fruits, vegetables,
                    dairy products, snacks and daily grocery items easily.
                </p>

                <div class="benefits">
                    <div class="benefit-item">
                        <span>✓</span>
                        <p>Fresh and quality products</p>
                    </div>

                    <div class="benefit-item">
                        <span>✓</span>
                        <p>Easy order tracking</p>
                    </div>

                    <div class="benefit-item">
                        <span>✓</span>
                        <p>Fast home delivery</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side Form -->
        <div class="signup-card">
            <div class="form-header">
                <h3>Sign Up</h3>
                <p>Enter your details to create your grocery account.</p>
            </div>

            <form asp-action="Signup" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="FullName">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="email">Email Address</label>
                    <input asp-for="email" class="form-control" placeholder="Enter your email address" />
                    <span asp-validation-for="email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="phone">Phone Number</label>
                    <input asp-for="phone" class="form-control" placeholder="Enter your phone number" />
                    <span asp-validation-for="phone" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create a password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="re_typepassword">Confirm Password</label>
                    <input asp-for="re_typepassword" type="password" class="form-control" placeholder="Re-type your password" />
                    <span asp-validation-for="re_typepassword" class="text-danger"></span>
                </div>

                <button type="submit" class="signup-btn">
                    Create Account
                </button>

                <div class="form-footer">
                    <p>
                        Already have an account?
                        <a asp-action="Login">Login here</a>
                    </p>

                    <a asp-controller="Home" asp-action="Index" class="back-home">
                        Back to Home
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}